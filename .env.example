# KSEC environment variables (all optional).
# KSEC_HOME overrides where KSEC stores its database and logs
# (default: ~/.local/share/ksec).
# KSEC_HOME=/path/to/ksec-data

# KSEC_CONFIG overrides the config file location
# (default: ~/.config/ksec/config.toml, or ./ksec.toml if present).
# KSEC_CONFIG=/path/to/config.toml